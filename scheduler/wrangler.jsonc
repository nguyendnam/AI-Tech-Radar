{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-tech-radar-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "nguyendnam",
    "GITHUB_REPO": "AI-Tech-Radar",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      "45 23 * * *",
      "30 0 * * *",
      "0 20 * * 6"
    ]
  }
}
